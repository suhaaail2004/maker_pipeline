# ──────────────────────────────────────────
# .gitignore – Maker static website project
# ──────────────────────────────────────────

# ── OS artefacts ──────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini
ehthumbs.db

# ── Editor / IDE ──────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.user

# ── Node / npm (if added later) ───────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.pnp
.pnp.js

# ── Build output ──────────────────────────
dist/
build/
out/

# ── Logs & temp ───────────────────────────
*.log
*.tmp
tmp/
.cache/

# ── Environment / secrets ─────────────────
.env
.env.*
*.pem
*.key
*.p12
secrets/

# ── Docker ────────────────────────────────
# (Dockerfile and .dockerignore are tracked)

# ── Terraform / Helm state ────────────────
*.tfstate
*.tfstate.backup
.terraform/
charts/*.tgz

